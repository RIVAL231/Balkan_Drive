# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8080/query

# Application Configuration
VITE_APP_NAME=Balkan Drive
VITE_APP_VERSION=1.0.0

# Upload Configuration
VITE_MAX_FILE_SIZE=50MB
VITE_ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Feature Flags
VITE_ENABLE_PUBLIC_SHARING=true
VITE_ENABLE_AUDIT_LOGS=true
VITE_ENABLE_STATISTICS=true