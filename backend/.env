# ======================
# DATABASE CONFIGURATION
# ======================
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=graphqlmvp

# ======================
# SERVER CONFIGURATION
# ======================
PORT=8080

# ======================
# JWT CONFIGURATION
# ======================
# IMPORTANT: Change this in production to a secure random string
JWT_SECRET=your-development-secret-change-in-production

# ======================
# AWS S3 CONFIGURATION
# ======================
# AWS Region (e.g., us-east-1, eu-west-1, eu-north-1)
AWS_REGION=eu-north-1

# AWS Credentials - REQUIRED for S3 operations
# Get these from your AWS IAM console
AWS_ACCESS_KEY_ID=AKIA2FXADQTYAAZEZQV3
AWS_SECRET_ACCESS_KEY=fZlpkuN9buEEU+3NLmrK6xEO7JANm5W/g46lx/WJ

# S3 Bucket name - ensure this bucket exists in your AWS account
S3_BUCKET=go-drive-v2

# ======================
# RATE LIMITING
# ======================
# Requests per second allowed per user
RATE_LIMIT=2.0
# Burst capacity for rate limiting
RATE_LIMIT_BURST=5

# ======================
# STORAGE QUOTAS
# ======================
# Default storage quota per user in bytes (10MB = 10485760 bytes)
DEFAULT_STORAGE_QUOTA=10485760

# ======================
# DEVELOPMENT NOTES
# ======================
# 1. Replace AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY with your actual AWS credentials
# 2. Ensure the S3_BUCKET exists in your AWS account and is accessible
# 3. Change JWT_SECRET to a secure random string in production
# 4. Adjust database credentials if needed
# 5. For production, use environment-specific values

# ======================
# AWS IAM PERMISSIONS REQUIRED
# ======================
# Your AWS user/role needs the following S3 permissions:
# - s3:GetObject
# - s3:PutObject
# - s3:DeleteObject
# - s3:ListBucket (optional, for bucket operations)
#
# Example IAM policy:
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "s3:GetObject",
#         "s3:PutObject", 
#         "s3:DeleteObject"
#       ],
#       "Resource": "arn:aws:s3:::go-drive-v2/*"
#     }
#   ]
# }