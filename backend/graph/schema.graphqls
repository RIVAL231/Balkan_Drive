# ==========================
# Scalars
# ==========================
scalar DateTime
scalar Upload

# ==========================
# User
# ==========================
type User {
  id: ID!
  username: String!
  email: String!
  password: String!
  role: String!
}

# Used for login/register response
type AuthPayload {
  token: String!
  user: User!
}

type Folder {
  id: ID!
  owner: User!
  name: String!
  parent: Folder
  createdAt: DateTime!
}

# ==========================
# File
# ==========================
type File {
  id: ID!
  filename: String!
  filehash: String!
  filepath: String!
  filetype: String!
  filesize: Int!
  isPublic: Boolean!
  isPublicShared: Boolean!
  publicShareEnabledAt: DateTime
  publicShareEnabledBy: User
  folder: Folder
  createdAt: DateTime!
  owner: User!
}

type Content{
  sha256: String!
  storage_key: String!
  size_bytes: Int!
  ref_count: Int!
  created_at: DateTime!
}

# Returned when creating upload
type UploadIntent {
  uploadUrl: String!
  uploadToken: String!
}

# ==========================
# Relations (Sharing)
# ==========================
type FileShares{
  id: ID!
  file: File
  sharedWith: User
  permission: String!
  sharedBy: User
  expiresAt: DateTime
}

# ==========================
# Public File Sharing
# ==========================
type PublicFile {
  id: ID!
  filename: String!
  filetype: String!
  filesize: Int!
  createdAt: DateTime!
  owner: User!
  downloadCount: Int!
  publicSharedAt: DateTime!
}

type FileDownload {
  id: ID!
  downloadedBy: User
  downloadedAt: DateTime!
  ipAddress: String
}

type FileDownloadStats {
  totalDownloads: Int!
  downloads: [FileDownload!]!
}

# ==========================
# Statistics
# ==========================
type UserStatistics {
  totalUsed: Int!
  originalSize: Int!
  savingsBytes: Int!
  savingsPercentage: Float!
  fileCount: Int!
  totalSharedFiles: Int!
  totalReceivedShares: Int!
}

type AdminStatistics {
  totalUsers: Int!
  totalFiles: Int!
  totalStorage: Int!
  totalSavings: Int!
  totalPublicFiles: Int!
  totalPublicDownloads: Int!
  topDownloadedFiles: [PublicFileStats!]!
  recentDownloads: [FileDownload!]!
}

type PublicFileStats {
  id: ID!
  filename: String!
  downloadCount: Int!
  owner: User!
  publicSharedAt: DateTime!
}

# ==========================
# Queries
# ==========================
type Query {
  # User Management
  me: User!
  listUsers: [User!]!
  listAllUsers: [User!]!

  # File Management
  listFiles(folderId: ID): [File!]!
  getFile(fileId: ID!): File
  searchFiles(query: String!): [File!]!
  listSharedFiles: [FileShares!]!
  
  # Public Files
  listPublicFiles: [PublicFile!]!
  getFileDownloadStats(fileId: ID!): FileDownloadStats!
  getDownloadUrl(fileId: ID!): String!

  # Folder management
  listFolders(parentId: ID): [Folder!]!
  
  # Statistics
  getUserStatistics: UserStatistics!
  
  # Admin
  getAdminStatistics: AdminStatistics!
  getAllFiles: [File!]!
}



# ==========================
# Mutations
# ==========================
type Mutation {
  # Auth
  register(username: String!, email: String!, password: String!, role: String!): AuthPayload!
  login(email: String!, password: String!): AuthPayload!
  changePassword(oldPassword: String!, newPassword: String!): Boolean!


  # File ops
  uploadFile(filename: String!, filetype: String!, filePath: String!, filesize: Int!, isPublic: Boolean!, file: Upload!): UploadIntent!
  completeUpload(uploadToken: String!): File!
  deleteFile(fileId: ID!): Boolean!
  changeVisibility(fileId: ID!, isPublic: Boolean!): File!
  moveFile(fileId: ID!, folderId: ID): File!
  createFolder(name: String!, parentId: ID): Folder!
  deleteFolder(folderId: ID!): Boolean!
  renameFolder(folderId: ID!, newName: String!): Folder!


  # Sharing
  shareFile(fileId: ID!, userId: ID!, relationship: String!): FileShares!
  shareFileByUsername(fileId: ID!, username: String!, permission: String!): FileShares!
  unshareFile(fileId: ID!, userId: ID!): Boolean!
  
  # Public Sharing
  shareFilePublicly(fileId: ID!): Boolean!
  unshareFilePublicly(fileId: ID!): Boolean!
  downloadPublicFile(fileId: ID!): String!
 
}
